  "grammar": [
    {
      "no": 42,
      "titleVi": "Câu có vị ngữ là động từ",
      "summaryVi": "Chủ ngữ + động từ + tân ngữ, giống trật tự tiếng Việt: 我叫大卫。",
      "explanationVi": [
        "Câu đơn giản nhất của tiếng Trung có trật tự giống tiếng Việt: **chủ ngữ + động từ + tân ngữ**.",
        "Trong câu 「我叫大卫」, 「我」 (tôi) là chủ ngữ, 「叫」 (tên là) là động từ, 「大卫」 là tân ngữ.",
        "Động từ tiếng Trung không đổi hình thức theo người nói hay theo thời gian: 我叫, 你叫, 他叫 đều giống nhau."
      ],
      "patterns": [
        "Chủ ngữ + động từ + tân ngữ"
      ],
      "examples": [
        {
          "zh": "我叫大卫。",
          "py": "wǒ jiào dà wèi",
          "vi": "Tôi tên là David."
        },
        {
          "zh": "她叫玛丽。",
          "py": "tā jiào mǎ lì",
          "vi": "Cô ấy tên là Mary."
        },
        {
          "zh": "你叫什么名字？",
          "py": "nǐ jiào shén me míng zi",
          "vi": "Bạn tên là gì?"
        }
      ],
      "review": {
        "status": "draft"
      }
    },
