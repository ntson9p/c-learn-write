  "grammar": [
    {
      "no": 5,
      "titleVi": "「想」 và 「要」: muốn",
      "summaryVi": "「想/要」 + động từ: muốn làm gì; 「要」 + danh từ: muốn có cái gì (khi gọi món). Phủ định: 「不想」.",
      "explanationVi": [
        "「想」 và 「要」 đứng **trước động từ** để nói mong muốn: 我想喝茶 (Tôi muốn uống trà), 我要吃饺子 (Tôi muốn ăn sủi cảo). Giống chữ 'muốn' trong tiếng Việt.",
        "「想」 nhẹ nhàng hơn (muốn, thích là…); 「要」 mạnh hơn, thể hiện ý định hoặc yêu cầu. Khi gọi món, nói 「我要…」: 我要一杯茶 (Cho tôi một cốc trà). Lúc này 「要」 đứng ngay trước danh từ.",
        "「想」 nghĩa 'muốn' **không** đứng ngay trước danh từ: không nói 我想茶. Hãy nói 我想喝茶 hoặc 我要茶.",
        "Phủ định thường dùng 「不想」: 我不想吃饭 (Tôi không muốn ăn). Câu hỏi: 你想吃什么？, 你想喝茶吗？, 你想不想喝茶？"
      ],
      "patterns": [
        "Chủ ngữ + 想/要 + động từ (+ tân ngữ)",
        "Chủ ngữ + 要 + (số lượng +) danh từ",
        "Chủ ngữ + 不想 + động từ (+ tân ngữ)"
      ],
      "examples": [
        {
          "zh": "我想吃苹果。",
          "py": "wǒ xiǎng chī píng guǒ",
          "vi": "Tôi muốn ăn táo."
        },
        {
          "zh": "我要两个包子。",
          "py": "wǒ yào liǎng gè bāo zi",
          "vi": "Cho tôi hai cái bánh bao."
        },
        {
          "zh": "他不想喝牛奶。",
          "py": "tā bù xiǎng hē niú nǎi",
          "vi": "Cậu ấy không muốn uống sữa."
        },
        {
          "zh": "你想不想吃饺子？",
          "py": "nǐ xiǎng bu xiǎng chī jiǎo zi",
          "vi": "Bạn có muốn ăn sủi cảo không?"
        }
      ],
      "mistakes": [
